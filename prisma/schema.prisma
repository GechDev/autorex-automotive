// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

enum Role {
  ADMIN
  ADVISOR
  TECHNICIAN
  CASHIER
}

enum OrderStatus {
  CHECKED_IN
  INSPECTION
  PENDING_APPROVAL
  IN_REPAIR
  READY_FOR_PAYMENT
  PAID
  COMPLETED
}

enum PaymentMethod {
  CASH
  CARD_POS
  MOBILE_TRANSFER
}

model Customer {
  id           Int      @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String   @unique
  phoneNumber  String
  addedDate    DateTime @default(now())
  
  vehicles     Vehicle[]
  orders       Order[]

  @@map("customers")
}

model Vehicle {
  id           Int      @id @default(autoincrement())
  customerId   Int
  year         Int
  make         String
  model        String
  mileage      Int
  licensePlate String
  vin          String?
  color        String?
  
  customer     Customer @relation(fields: [customerId], references: [id])
  orders       Order[]

  @@map("vehicles")
}

model Employee {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  phoneNumber  String?
  role         Role
  isActive     Boolean  @default(true)
  addedDate    DateTime @default(now()) @updatedAt
  
  advisedOrders   Order[] @relation("OrderAdvisor")
  assignedOrders  Order[] @relation("OrderTechnician")

  @@map("employees")
}

model Order {
  id                Int         @id @default(autoincrement())
  orderHash         String      @unique @default(uuid())
  customerId        Int
  vehicleId         Int
  advisorId         Int?        // employee that created/advises
  technicianId      Int?        // employee assigned to repair
  status            OrderStatus @default(CHECKED_IN)
  
  // Intake data
  checkInMileage    Int?
  fuelLevel         String?     // e.g. "1/4", "1/2", "Full"
  complaints        String?     @db.Text
  damagePhotos      String[]    // Array of URLs to R2/S3
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  completedAt       DateTime?

  customer          Customer    @relation(fields: [customerId], references: [id])
  vehicle           Vehicle     @relation(fields: [vehicleId], references: [id])
  advisor           Employee?   @relation(fields: [advisorId], references: [id], name: "OrderAdvisor")
  technician        Employee?   @relation(fields: [technicianId], references: [id], name: "OrderTechnician")
  
  items             JobItem[]
  payments          Payment[]

  @@map("orders")
}

model JobItem {
  id              Int      @id @default(autoincrement())
  orderId         Int
  itemName        String
  itemType        String   // "PART" or "LABOR"
  quantity        Int      @default(1)
  unitPrice       Float    @default(0.0)
  isApproved      Boolean  @default(false)
  technicianNotes String?  @db.Text
  isCompleted     Boolean  @default(false)
  
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("job_items")
}

model Payment {
  id              Int           @id @default(autoincrement())
  orderId         Int
  amount          Float
  paymentMethod   PaymentMethod
  referenceNumber String?
  cashierId       Int?
  createdAt       DateTime      @default(now())
  
  order           Order         @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model Appointment {
  id            Int      @id @default(autoincrement())
  customerName  String
  email         String
  phone         String
  vehicleInfo   String?
  preferredDate String
  preferredTime String
  message       String?  @db.Text
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("appointments")
}

model CommonService {
  id                  Int     @id @default(autoincrement())
  name                String
  description         String? @db.Text
  defaultLaborPrice   Float   @default(0.0)

  @@map("common_services")
}