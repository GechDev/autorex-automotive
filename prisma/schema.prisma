// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model CustomerIdentifier {
  customer_id           Int      @id @default(autoincrement())
  customer_email        String   @unique
  customer_phone_number String
  customer_added_date   DateTime @default(now()) @updatedAt
  customer_hash         String

  info     CustomerInfo?
  vehicles CustomerVehicleInfo[]
  orders   Order[]

  @@map("customer_identifier")
}

model CustomerInfo {
  customer_info_id       Int @id @default(autoincrement())
  customer_id            Int @unique
  customer_first_name    String
  customer_last_name     String
  active_customer_status Int

  customer CustomerIdentifier @relation(fields: [customer_id], references: [customer_id])

  @@map("customer_info")
}

model CustomerVehicleInfo {
  vehicle_id      Int    @id @default(autoincrement())
  customer_id     Int
  vehicle_year    Int
  vehicle_make    String
  vehicle_model   String
  vehicle_type    String
  vehicle_mileage Int
  vehicle_tag     String
  vehicle_serial  String
  vehicle_color   String

  customer CustomerIdentifier @relation(fields: [customer_id], references: [customer_id])
  orders   Order[]

  @@map("customer_vehicle_info")
}

model CompanyRole {
  company_role_id   Int    @id @default(autoincrement())
  company_role_name String @unique

  employee_roles EmployeeRole[]

  @@map("company_roles")
}

model CommonService {
  service_id          Int     @id @default(autoincrement())
  service_name        String
  service_description String? @db.Text

  order_services OrderService[]
  appointments   Appointment[]

  @@map("common_services")
}

model Employee {
  employee_id     Int      @id @default(autoincrement())
  employee_email  String   @unique
  active_employee Int
  added_date      DateTime @default(now()) @updatedAt

  info     EmployeeInfo?
  pass     EmployeePass?
  roles    EmployeeRole[]
  orders   Order[]

  @@map("employee")
}

model EmployeeInfo {
  employee_info_id    Int    @id @default(autoincrement())
  employee_id         Int    @unique
  employee_first_name String
  employee_last_name  String
  employee_phone      String

  employee Employee @relation(fields: [employee_id], references: [employee_id])

  @@map("employee_info")
}

model EmployeePass {
  employee_pass_id         Int    @id @default(autoincrement())
  employee_id              Int    @unique
  employee_password_hashed String

  employee Employee @relation(fields: [employee_id], references: [employee_id])

  @@map("employee_pass")
}

model EmployeeRole {
  employee_role_id Int @id @default(autoincrement())
  employee_id      Int
  company_role_id  Int

  employee Employee    @relation(fields: [employee_id], references: [employee_id])
  role     CompanyRole @relation(fields: [company_role_id], references: [company_role_id])

  @@map("employee_role")
}

model Order {
  order_id     Int      @id @default(autoincrement())
  employee_id  Int
  customer_id  Int
  vehicle_id   Int
  order_date   DateTime @default(now())
  active_order Int
  order_hash   String

  employee Employee            @relation(fields: [employee_id], references: [employee_id])
  customer CustomerIdentifier  @relation(fields: [customer_id], references: [customer_id])
  vehicle  CustomerVehicleInfo @relation(fields: [vehicle_id], references: [vehicle_id])

  info     OrderInfo?
  services OrderService[]
  statuses OrderStatus[]

  @@map("orders")
}

model OrderInfo {
  order_info_id                 Int       @id @default(autoincrement())
  order_id                      Int       @unique
  order_total_price             Int
  estimated_completion_date     DateTime? @default(now())
  completion_date               DateTime?
  additional_request            String?   @db.Text
  notes_for_internal_use        String?   @db.Text
  notes_for_customer            String?   @db.Text
  additional_requests_completed Int

  order Order @relation(fields: [order_id], references: [order_id])

  @@map("order_info")
}

model OrderService {
  order_service_id  Int @id @default(autoincrement())
  order_id          Int
  service_id        Int
  service_completed Int

  order   Order         @relation(fields: [order_id], references: [order_id])
  service CommonService @relation(fields: [service_id], references: [service_id])

  @@map("order_services")
}

model OrderStatus {
  order_status_id Int @id @default(autoincrement())
  order_id        Int
  order_status    Int

  order Order @relation(fields: [order_id], references: [order_id])

  @@map("order_status")
}

model Appointment {
  id            Int      @id @default(autoincrement())
  customerName  String
  email         String
  phone         String
  vehicleInfo   String?
  serviceId     Int?
  preferredDate String
  preferredTime String
  message       String?  @db.Text
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  service       CommonService? @relation(fields: [serviceId], references: [service_id])

  @@map("appointments")
}